end
   
print PickAndPlace.getDestination
// a target control with a sensor might, for example, look like this:
if not ?.Empty
   if @.PreviousLocation = Conveyor
       ?.setDestination(Station, false)
   else
       ?.setDestination(Conveyor.Sensors.id2, false)
