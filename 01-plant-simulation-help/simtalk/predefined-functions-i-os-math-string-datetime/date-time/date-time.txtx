Sonnenfinsternis := str_to_datetime("11.8.99 11:30:00")
t := timeOfDay(Sonnenfinsternis)
print t // 11:30:00.0000
d := getDate(Sonnenfinsternis)
print d // returns 11.08.1999, model language German
